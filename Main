sensor:


  - platform: dht
    pin: GPIO2
    model: AM2302
    temperature:
      name: "Kotelna T"
    humidity:
      name: "Kotelna Rh"
    update_interval: 10s

  - platform: template
    name: "LG Error Code"
    id: lg_error_code



  - platform: template
    name: "LG Setpoint"
    id: lg_setpoint
    unit_of_measurement: "°C"

  - platform: template
    name: "LG Water IN"
    id: lg_water_in
    unit_of_measurement: "°C"

  - platform: template
    name: "LG Water OUT"
    id: lg_water_out
    unit_of_measurement: "°C"


  - platform: dallas_temp
    id: inlet
    name: inlet
    accuracy_decimals: 3
    update_interval: 5s
    address: 0x653c790457af3e28

  - platform: dallas_temp
    id: outlet
    name: outlet
    accuracy_decimals: 3
    update_interval: 5s
    address: 0xaf0723b05b989228

  - platform: template
    id: diff
    name: diff
    icon: mdi:thermometer-chevron-up
    unit_of_measurement: "°C"
    accuracy_decimals: 2
    update_interval: 5s
    lambda: |-
      if (isnan(id(inlet).state) || isnan(id(outlet).state)) {
        return NAN;
      }
      return (id(outlet).state - id(inlet).state) + 0.31;

  - platform: template
    id: power_kw
    name: heating_power
    icon: mdi:flash
    unit_of_measurement: "kW"
    accuracy_decimals: 1
    update_interval: 5s
    lambda: |-
      if (!id(lg_heat).state) {
        return NAN;
      }

      if (isnan(id(diff).state)) {
        return NAN;
      }

      return 3.10 * (id(diff).state) + 0.03;
